#!/usr/bin/env python

import sys
import os
import traceback

from importlib import import_module
import argparse

try:
    SQUID_DIR = str(os.environ['SQUID_DIR'])
except Exception as e:
    print("Couldn't source squid directory")
    print(e)    

# create squid_DIR path
sys.path.append(os.path.expanduser(SQUID_DIR))

'''
argument list:
1 - Which pack? Acquisition, Calibration, etc.
2 - config file
'''
parser = argparse.ArgumentParser(description='Executable for running squid packs', usage='''
======================================
MULE pack runtime executable
Use 'squid --help' for more information
======================================''', formatter_class=argparse.RawTextHelpFormatter)

parser.add_argument("pack", choices = ['acq','proc','tests','ana'], help = '''The pack implemented: 
        acq   - Acquisition of data using Keithley
        ''')
parser.add_argument("config", help = 'The config file provided to the pack, this differs based on which pack youre using')
# acquire arguments

args = parser.parse_args()

# import pack and run
try:
    module_name = f'packs.{args.pack}.{args.pack}'
    print(f"Running {module_name} with config {args.config}")
    pack = getattr(import_module(module_name), args.pack)
except ModuleNotFoundError:
    print(f"Failed to find pack {args.pack}")
    traceback.print_exc()
    exit(1)
else:
    pack(args.config)
